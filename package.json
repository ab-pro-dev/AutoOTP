{
  "name": "autootp-monorepo",
  "version": "0.1.0",
  "description": "Automated OTP detection and autofill for Gmail",
  "author": "Abera Hagazi",
  "license": "MIT",
  "repository": "git+https://github.com/ab-pro-dev/AutoOTP.git",
  "bugs": "https://github.com/ab-pro-dev/AutoOTP/issues",
  "homepage": "https://github.com/ab-pro-dev/AutoOTP",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "build:ext": "npm run build:ext -w @autootp/browser-extension",
    "build:publish": "node scripts/build-publish.mjs",
    "scan:publish": "node scripts/scan-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
